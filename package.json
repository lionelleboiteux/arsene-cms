{
  "name": "arsene-cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Arsène — CMS + public website for Fantasy Coach.",
  "scripts": {
    "setup:contract": "python3 -m venv .venv-contract && .venv-contract/bin/pip install --disable-pip-version-check schemathesis",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/telemetry",
    "test:db": "vitest run tests/db",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "vitest run tests/e2e",
    "create-writer": "node --experimental-strip-types scripts/create-writer.ts"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.2",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-check": "^3.23.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "aws4fetch": "^1.0.20",
    "jose": "^6.2.8",
    "libheif-js": "^1.19.8",
    "pg": "^8.22.0",
    "sanitize-html": "^2.17.6",
    "sharp": "0.35.3",
    "zod": "^4.4.3"
  }
}
