textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"h2tz52723","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Avoir trois joueurs de Bodø/Glimt lors de la journée 6 semble aussi être un impératif. Le choix du moment où ces actifs intégreront votre effectif aura son importance. Dès la journée 3 ou au contraire, attendre la journée 5 et que leur déplacement à Viking lors du choc de la journée 4 soit passé ? A suivre.","decorations":[]}}],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"9ilie2634","nodes":[],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"xs4s21145","nodes":[],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"jbf4o734","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Équipes à cibler","decorations":[{"type":"BOLD","fontWeightValue":700},{"type":"UNDERLINE"}]}}],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"qbtz1736","nodes":[],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"cb3j4737","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Fredrikstad","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" pour son calendrier abordable sur les 3 prochaines journées (KFUM, aafk, VIF).","decorations":[]}}],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"axd11740","nodes":[],"style":{},"paragraphData":{"textStyle":{"textAlignment":"AUTO"}}},{"type":"PARAGRAPH","id":"24wjk741","nodes":[{"type":"TEXT","id":"","nodes":[],"textData":{"text":"Tromsø","decorations":[{"type":"BOLD","fontWeightValue":700}]}},{"type":"TEXT","id":"","nodes":[],"textData":{"text":" va doubler en journée 4 soit 4 matchs à disputer sur les 3 prochaines journées dont 3 réceptions à domicile.","decorations":[]}}],"style"